{
  "name": "safe-browsing-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "A monorepo for the Safe Browsing browser extension and its corresponding web application.",
  "workspaces": [
    "packages/extension",
    "packages/web",
    "packages/api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix packages/web\" \"python packages/api/main.py\" \"node packages/extension/server.js\"",
    "build": "npm run build --prefix packages/web",
    "analyze": "cross-env ANALYZE=true npm run build",
    "start": "npm run start --workspace=web",
    "lint": "npm run lint --workspace=web"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@hookform/resolvers": "^4.1.1",
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/chrome": "^0.1.27",
    "@types/dom-speech-recognition": "^0.0.7",
    "@types/markdown-it": "^14.1.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "markdown-it": "^14.1.0",
    "next": "^15.5.3",
    "next-auth": "5.0.0-beta.30",
    "node-fetch": "^2.7.0",
    "puppeteer": "^24.27.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.3.0",
    "resend": "^4.1.2",
    "sonner": "^2.0.7",
    "sqlite3": "^5.1.7",
    "systeminformation": "^5.27.11",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.0.1",
    "@types/archiver": "^6.0.3",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.14",
    "@types/react": "^19",
    "archiver": "^7.0.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "prisma": "^6.16.1",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
